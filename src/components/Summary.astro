---
interface Props {
  title: string;
  subtitle?: string;
  description: string;
}

const { title, subtitle, description } = Astro.props;
---

<div class="summary">
  <div class="section-header">
    <h2>{title}</h2>
    <p class="section-subheader">{subtitle}</p>
  </div>
  <div class="summary-box">
    <p>{description}</p>
  </div>
</div>
