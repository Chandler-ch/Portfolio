---
import BaseHead from "../components/seitenlayout/BaseHead.astro";
import Footer from "../components/seitenlayout/Footer.astro";
import Header from "../components/seitenlayout/HeaderNav.astro";
import Summary from "../components/Summary.astro";
import Projectcard from "../components/Projectcard.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
  </head>
  <Header />
  <main>
    <body class="backgroundImage">
      <div class="splash">
        <div>
          <div class="splash-header">
            <h2>
              Heyy, I'm <span style="color: var(--accent);">Amelia</span>!
            </h2>
          </div>
          <div class="splash-subheader">
            <p>
              21 years old ISFJ who likes to{" "}
              <span style="color: var(--accent);" id="typing"></span>
            </p>
          </div>
        </div>

        <div class="splash-image">
          <a href="https://www.youtube.com/watch?v=eeTuK5acfFU">
            <img src="/src/assets/Hi.jpg" alt="Hi" />
          </a>
        </div>
      </div>

      <hr class="section-seperation" />

      <Summary />

      <div class="projects">
        <div class="section-header">
          <h2>Projects</h2>
          <p class="section-subheader">
            Some of my projects, more can be found on my{" "}
            <a href="https://github.com/uncutified">GitHub</a>
          </p>
        </div>
        <div class="cluster">
          <Projectcard
            href="https://keltrix.net/"
            img="https://keltrix.net/assets/keltrix-white.webp"
            title="Keltrix"
            description="Affordable server hosting"
          />

          <Projectcard
            href="#"
            img="https://cdn.discordapp.com/icons/1183800558629441587/f6078f12b424e96742a77acdaedbb174.webp?size=1024"
            title="Valendria.net"
            description="Minecraft server network (paused)"
          />
        </div>
      </div>

      <hr class="section-seperation" />
      <div class="box">h</div>
    </body>
  </main>
  <Footer />

  <style>
    .backgroundImage {
      /* background-image: url("/src/assets/astro.svg");
      background-size: cover; */
    }
    .box {
      width: 300px;
      height: 300px;
      background-image: url("/src/assets/astro.svg");
    }
  </style>

  <script>
    const words = [
      "program software.",
      "be silly..",
      "cook meals!",
      "build great stuff!",
    ];
    let i = 0;
    let j = 0;
    let currentWord = "";
    let isDeleting = false;
    const speed = 100;
    const eraseSpeed = 80;
    const delay = 3000;

    function type() {
      currentWord = words[i];

      if (!isDeleting) {
        document.getElementById("typing").textContent = currentWord.substring(
          0,
          j + 1,
        );
        j++;
        if (j === currentWord.length) {
          isDeleting = true;
          setTimeout(type, delay);
          return;
        }
      } else {
        document.getElementById("typing").textContent = currentWord.substring(
          0,
          j - 1,
        );
        j--;
        if (j === 0) {
          isDeleting = false;
          i = (i + 1) % words.length;
        }
      }
      setTimeout(type, isDeleting ? eraseSpeed : speed);
    }

    type();

    // amy...
    (function () {
      const amy = document.querySelector(
        '.friendpic[href="https://amy.rip"], .friendpic[title="amyulated (jar)"]',
      );

      if (!amy) {
        console.warn("Amy not found!");
        return;
      }

      amy.addEventListener("contextmenu", (e) => {
        e.preventDefault();

        amy.classList.remove("eighteightpic--spin");
        void amy.offsetWidth;
        amy.classList.add("eighteightpic--spin");
      });
    })();
  </script>
</html>
